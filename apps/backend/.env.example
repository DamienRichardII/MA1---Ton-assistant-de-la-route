# MA1 Backend — variables d'environnement
# [Sprint Étape 3] Reorganisée pour structure monorepo apps/backend.
# Aucun secret réel ne doit jamais être commité — uniquement des placeholders.
# Source canonique : docs/CLAUDE.md §8 et docs/SPRINT_ETAPE_2_NETTOYAGE_AVANT_PAIEMENT.md §7.

# ── Anthropic (Claude API) — REQUIRED ───────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Supabase ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Alias service role : utiliser SUPABASE_SERVICE_ROLE_KEY OU SUPABASE_SERVICE_KEY (le code accepte les deux).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── JWT ─────────────────────────────────────────────
# [Sprint Étape 2] >=32 caractères en production ; différent du défaut. Refus de démarrage sinon.
JWT_SECRET=your-random-secret-min-32-chars
JWT_EXPIRY_HOURS=168

# ── Resend (emails transactionnels) — DOMAINE ma1.fr VÉRIFIÉ ─────
# [Sprint Admin/Emails/Support] Damien a vérifié le domaine MA1.fr dans Resend.
# Boîte mail OVH non disponible (quota 0/0) → redirection contact@ma1.fr en place.
RESEND_API_KEY=re_...
RESEND_FROM="MA1 <contact@ma1.fr>"
RESEND_FROM_EMAIL=contact@ma1.fr
FROM_EMAIL=contact@ma1.fr
EMAIL_FROM="MA1 <contact@ma1.fr>"     # alias rétro-compat
RESEND_REPLY_TO=contact@ma1.fr
ADMIN_EMAIL=contact@ma1.fr
ADMIN_NOTIFICATION_EMAIL=contact@ma1.fr
SUPPORT_EMAIL=contact@ma1.fr

# ── App / Réseau ─────────────────────────────────────
APP_ENV=development              # development | production
APP_URL=http://localhost:8000
FRONTEND_URL=https://ma1.fr
BACKEND_URL=https://ma1-ton-assistant-de-la-route-production.up.railway.app
PORT=8000

# [Sprint Étape 2] CORS strict — pas de wildcard en production.
# Dev tolère localhost ; production exige domaines listés ci-dessous.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ma1.fr,https://www.ma1.fr

# ── Admin (rôle vérifié côté backend, jamais côté client) ──
# [Sprint Étape 2] Emails séparés par virgule autorisés à appeler les routes admin (legacy).
ADMIN_EMAILS=contact@ma1.fr

# ── Auth admin (Sprint Admin/Emails/Support) ────────
# Hash bcrypt du mot de passe admin. NE JAMAIS METTRE LE MOT DE PASSE EN CLAIR.
# Pour générer le hash de "Flash" (ou tout autre mot de passe choisi) :
#   python -c "import bcrypt; print(bcrypt.hashpw(b'Flash', bcrypt.gensalt()).decode())"
# Coller le résultat (commençant par $2b$) ci-dessous.
# Au premier démarrage, le backend seed l'admin dans la table admin_users à partir de cette valeur.
ADMIN_PASSWORD_HASH=
ADMIN_RESET_TOKEN_EXPIRY_MINUTES=30

# ── Bêta SumUp 30 jours (placeholders, Sprint Étape 2/4) ────
# [Sprint Étape 3] Aucun lien SumUp réel commité ici. Les vrais liens seront
# fournis par Damien et configurés dans Railway → variables d'environnement.
PAYMENT_PROVIDER=sumup_link_manual
BETA_PAYMENT_MODE=manual
BETA_ACCESS_DAYS=30
BETA_PARTICULIER_PRICE=9
BETA_AUTOECOLE_PRICE=200
SUMUP_PAYMENT_LINK_PARTICULIER_30_DAYS=
SUMUP_PAYMENT_LINK_AUTOECOLE_30_DAYS=

# ── Optionnel V2 (API SumUp + webhook) — laisser vide en V1 ──
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_MERCHANT_CODE=
SUMUP_WEBHOOK_SECRET=

# ── Stripe (DÉSACTIVÉ pendant la bêta SumUp) ───────────
# [Sprint Étape 2] Présent uniquement pour rétro-compat. À nettoyer Sprint D/SumUp.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_AUTOECOLE_PRICE_ID=
